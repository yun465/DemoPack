{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "conditions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1600
    },
    "limitations": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1600
    },
    "chapters": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "caption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "metrics",
              "image",
              "video"
            ]
          },
          "origin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "seconds": {
            "default": 6,
            "type": "number",
            "minimum": 3,
            "maximum": 20
          },
          "startSeconds": {
            "default": 0,
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "title",
          "caption",
          "file",
          "kind",
          "origin",
          "seconds",
          "startSeconds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "summary",
    "conditions",
    "limitations",
    "chapters"
  ],
  "additionalProperties": false
}
