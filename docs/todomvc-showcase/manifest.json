  "title": "TodoMVC · 从任务清单到完成记录",
  "events": [
    {
      "index": 0,
      "action": "open",
      "caption": "TodoMVC：用一份简单的任务清单，体验完整的待办流程。",
      "startMs": 0.5537000000001626,
      "endMs": 4630.7207
    },
    {
      "index": 1,
      "action": "fill",
      "caption": "第一步：在顶部输入框填写任务，所有内容均为虚构演示数据。",
      "startMs": 4630.7576,
      "endMs": 8275.9444
    },
    {
      "index": 2,
      "action": "press",
      "caption": "按回车提交，第一条任务进入清单。",
      "startMs": 8275.9632,
      "endMs": 12873.325200000001,
      "screenshot": "screenshots/step-03.jpg",
      "screenshotAtMs": 12754.773500000001
    },
    {
      "index": 3,
      "action": "fill",
      "caption": "继续添加第二条：录制功能演示。",
      "startMs": 12873.3834,
      "endMs": 15839.1588
    },
    {
      "index": 4,
      "action": "press",
      "caption": "再次回车提交，待完成数量随之更新。",
      "startMs": 15839.179600000001,
      "endMs": 19916.5455
    },
    {
      "index": 5,
      "action": "fill",
      "caption": "再添加一项检查任务，把发布前的工作列清楚。",
      "startMs": 19916.568700000003,
      "endMs": 22904.7702
    },
    {
      "index": 6,
      "action": "press",
      "caption": "三项任务已建立：项目介绍、功能演示和发布检查。",
      "startMs": 22904.795100000003,
      "endMs": 28090.182699999998,
      "screenshot": "screenshots/step-07.jpg",
      "screenshotAtMs": 27976.1708
    },
    {
      "index": 7,
      "action": "click",
      "caption": "点击「整理项目介绍」左侧的圆圈，将这项任务标记为完成。",
      "startMs": 28090.280100000004,
      "endMs": 33317.8261,
      "screenshot": "screenshots/step-08.jpg",
      "screenshotAtMs": 33212.3945
    },
    {
      "index": 8,
      "action": "wait",
      "caption": "确认完成状态：文字出现删除线，剩余待办变为两项。",
      "startMs": 33317.8491,
      "endMs": 37439.0829
    },
    {
      "index": 9,
      "action": "click",
      "caption": "选择 Active（待完成），只查看接下来需要处理的任务。",
      "startMs": 37439.106,
      "endMs": 42741.7219,
      "screenshot": "screenshots/step-10.jpg",
      "screenshotAtMs": 42628.759399999995
    },
    {
      "index": 10,
      "action": "wait",
      "caption": "待完成视图保留录制演示和检查材料，便于专注下一步。",
      "startMs": 42741.7526,
      "endMs": 46803.8423
    },
    {
      "index": 11,
      "action": "click",
      "caption": "切换 Completed（已完成），查看已经做好的项目介绍。",
      "startMs": 46803.8616,
      "endMs": 52115.8422,
      "screenshot": "screenshots/step-12.jpg",
      "screenshotAtMs": 52010.4658
    },
    {
      "index": 12,
      "action": "click",
      "caption": "回到 All（全部），把已完成和待完成任务放在一起检查。",
      "startMs": 52115.8618,
      "endMs": 56278.409999999996
    },
    {
      "index": 13,
      "action": "click",
      "caption": "点击 Clear completed（清除已完成），清单只保留未完成事项。",
      "startMs": 56278.4254,
      "endMs": 61409.1434,
      "screenshot": "screenshots/step-14.jpg",
      "screenshotAtMs": 61294.6034
    },
    {
      "index": 14,
      "action": "wait",
      "caption": "最终剩余两项：录制功能演示、检查发布材料。",
      "startMs": 61409.1685,
      "endMs": 65967.76190000001,
      "screenshot": "screenshots/step-15.jpg",
      "screenshotAtMs": 65844.92510000001
    }
