{
  "name": "demopack-local",
  "version": "0.1.0",
  "private": true,
  "description": "One browser run. A complete GitHub demo pack.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "demopack": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples/starter",
    "examples/launch",
    "examples/中文便签",
    "demo.schema.json",
    "THIRD_PARTY_NOTICES.md",
    "docs/licenses"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "schema": "node scripts/schema.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node tests/integration.mjs",
    "test:acceptance": "node tests/acceptance.mjs",
    "demo": "node dist/cli.js generate examples/starter/demo.json",
    "doctor": "node dist/cli.js doctor",
    "test:artifacts": "node tests/review-artifacts.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:cli": "node tests/cli.mjs",
    "test:edges": "node tests/edges.mjs",
    "format:check": "prettier --check src tests package.json tsconfig.json",
    "test:kit": "node tests/kit-integration.mjs",
    "test:keyboard": "node tests/keyboard.mjs"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
